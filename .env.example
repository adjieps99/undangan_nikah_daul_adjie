# Hachi Garden 3D - Production Environment Configuration
FLASK_ENV=production
SECRET_KEY=generate-a-secure-random-key-here-for-production
PORT=5000

# SQLite Persistent Database Configuration
# Set this to a path on a mounted persistent volume (e.g., /mnt/data/wedding.db or /data/wedding.db)
# Defaults to 'instance/wedding.db' inside project root if unset.
DATABASE_PATH=instance/wedding.db

# Optional Redis URL for centralized multi-worker rate limiting (if enabled)
# REDIS_URL=redis://localhost:6379/0
